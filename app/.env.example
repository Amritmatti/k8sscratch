# Local development only. In Kubernetes these come from the Helm chart:
# non-secret values via ConfigMap, credentials via Secret.
NODE_ENV=development
PORT=3000
METRICS_PORT=9090
LOG_LEVEL=debug
LOG_PRETTY=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=employees
DB_USER=employee_app
DB_PASSWORD=change-me-locally
DB_SSL=false
DB_POOL_MAX=10

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
METRICS_ENABLED=true
