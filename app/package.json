{
  "name": "employee-api",
  "version": "1.0.0",
  "description": "Employee records API — Node.js + PostgreSQL, deployed to Kubernetes via Helm behind Istio",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test --experimental-test-coverage tests/",
    "test:unit": "node --test tests/unit.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "lint": "eslint src tests",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "supertest": "^7.0.0"
  },
  "license": "MIT"
}
